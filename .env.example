# Copy this file to backend/.env  (or .env in the project root) and fill in what you have.
# NEVER commit the real .env file.

# ---- AI provider: groq | gemini | nvidia | openai | anthropic | none -------
# "none" still works: the app falls back to rule-based triage and retrieval-only answers.
LLM_PROVIDER=none

# Add the key for the provider you chose (free tiers: Groq, Gemini, NVIDIA NIM)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override default models if a model name is retired or you want another one
LLM_MODEL=
LLM_VISION_MODEL=

# ---- Database ---------------------------------------------------------------
# Default is SQLite (zero setup). For MySQL: pip install pymysql, then:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/tech4disaster
DATABASE_URL=

# ---- Map center (default Tirunelveli) ---------------------------------------
DEFAULT_LAT=8.7139
DEFAULT_LNG=77.7567

# ---- Optional email alerts (Gmail needs an App Password) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
